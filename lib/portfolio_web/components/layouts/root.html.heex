<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{assigns[:page_title] || "Mandar Joshi"}</title>
    <meta
      name="description"
      content="Mandar Joshi is a software engineer contributing to Supabase, FOSSology and Elixir, and the author of Stampede, a load-testing library for Phoenix."
    />
    <meta property="og:title" content={assigns[:page_title] || "Mandar Joshi"} />
    <meta
      property="og:description"
      content="Open source work on Supabase, FOSSology and Elixir, and Stampede, a load-testing library for Phoenix."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://mandarjoshi.me" />
    <meta property="og:image" content="https://mandarjoshi.me/images/profile.jpg" />
    <link rel="canonical" href="https://mandarjoshi.me" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={~p"/favicon.svg"} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link rel="stylesheet" href={~p"/css/app.css"} />
    <script defer src={~p"/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
